# The browser-safe Supabase project settings. Use the same values locally and in Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Canonical origins for auth redirects and fixed public links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PUBLISHER_URL=http://localhost:3001

# Server-only, least-privilege PostgreSQL role used by the trusted pipeline.
# Use the Supabase transaction pooler URL and tagworks_ingest role in production.
SUPABASE_DATABASE_URL=postgresql://tagworks_ingest.project-ref:password@pooler-host:6543/postgres

# Local migration/E2E only. Never configure this in Vercel.
SUPABASE_ADMIN_DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres
SUPABASE_E2E_DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres

# Publisher app uses server-only names so the values are not embedded in its browser bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
